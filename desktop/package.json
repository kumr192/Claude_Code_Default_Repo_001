{
  "name": "orbit-desktop",
  "version": "0.1.0",
  "description": "DexClorageBot desktop app (Windows and Mac). Opens your DexClorageBot server.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "app.dexcloragebot.desktop",
    "productName": "DexClorageBot",
    "files": ["main.js", "setup.html"]
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  }
}
